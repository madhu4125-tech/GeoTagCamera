<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/gpsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Finding location…"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/editBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit text"
            android:textColor="#FFB000" />

        <Button
            android:id="@+id/qrBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QR: Maps link"
            android:textColor="#FFB000" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/previewFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.madhu.geotagcamera.StampView
            android:id="@+id/stampView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Button
            android:id="@+id/modeBtn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Mode: Photo"
            android:textColor="#FFB000" />

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="28dp"
            android:background="@drawable/thumb_bg"
            android:clipToOutline="true"
            android:contentDescription="Open last photo"
            android:scaleType="centerCrop" />

        <ImageButton
            android:id="@+id/shutter"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="center"
            android:background="@drawable/shutter_bg"
            android:contentDescription="Take photo" />

        <ImageButton
            android:id="@+id/flip"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="28dp"
            android:background="@drawable/circle_dark"
            android:contentDescription="Switch camera"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="#FFFFFF" />
    </FrameLayout>
</LinearLayout>
